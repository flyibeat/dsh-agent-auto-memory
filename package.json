{
  "name": "dsh-agent-auto-memory",
  "version": "1.0.0",
  "description": "Auditable automatic memory infrastructure for DeepSeek Harness: turn-end checkpoint reminders plus a revision-checked shared-memory writer.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./checkpoint": "./checkpoint-entry.js",
    "./writer": "./writer-entry.js",
    "./package.json": "./package.json",
    "./checkpoint/locale/*.json": "./locale/checkpoint/*.json",
    "./checkpoint/icon": "./icon-checkpoint.svg",
    "./writer/locale/*.json": "./locale/writer/*.json",
    "./writer/icon": "./icon-writer.svg"
  },
  "files": [
    "index.js",
    "checkpoint-entry.js",
    "writer-entry.js",
    "checkpoint.mjs",
    "memory-tool.mjs",
    "memory-store.mjs",
    "cordis.patch.yml",
    "README.md",
    "locale",
    "icon-checkpoint.svg",
    "icon-writer.svg"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "memory",
    "agent-memory",
    "hooks"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flyibeat/dsh-agent-auto-memory.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.2.1-rc.3 <0.3.0",
      "node": ">=22.18"
    },
    "profiles": [
      "desktop",
      "web"
    ]
  }
}
